/* ============================================
   Amazon Location Service - QSS Theme
   ============================================ */

/* --- Dialog Base --- */
QDialog {
    background-color: #F5F7FA;
    color: #16191F;
}

/* --- Labels --- */
QLabel {
    color: #16191F;
    font-size: 13px;
}

/* --- Title Label --- */
QLabel#main_label {
    background-color: #232F3E;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    padding: 14px 16px;
    border-radius: 6px;
}

/* --- Group Box --- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D5DBDB;
    border-radius: 6px;
    padding: 20px 12px 12px 12px;
    margin-top: 14px;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #545B64;
    font-weight: bold;
    font-size: 12px;
}

/* --- Line Edit --- */
QLineEdit {
    border: 1px solid #D5DBDB;
    border-radius: 4px;
    padding: 7px 10px;
    background-color: #FFFFFF;
    color: #16191F;
    font-size: 13px;
    min-height: 18px;
}

QLineEdit:focus {
    border: 2px solid #FF9900;
    padding: 6px 9px;
}

QLineEdit:disabled {
    background-color: #F2F3F3;
    color: #687078;
    border: 1px solid #D5DBDB;
}

/* --- Combo Box --- */
QComboBox {
    border: 1px solid #D5DBDB;
    border-radius: 4px;
    padding: 7px 10px;
    background-color: #FFFFFF;
    color: #16191F;
    font-size: 13px;
    min-height: 18px;
}

QComboBox:hover {
    border: 1px solid #879596;
}

QComboBox:focus {
    border: 2px solid #FF9900;
    padding: 6px 9px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #D5DBDB;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #FAFAFA;
}

QComboBox QAbstractItemView {
    border: 1px solid #D5DBDB;
    background-color: #FFFFFF;
    color: #16191F;
    selection-background-color: #FF9900;
    selection-color: #16191F;
    padding: 4px;
}

QComboBox:disabled {
    background-color: #F2F3F3;
    color: #687078;
    border: 1px solid #D5DBDB;
}

/* --- Spin Box --- */
QSpinBox {
    border: 1px solid #D5DBDB;
    border-radius: 4px;
    padding: 7px 10px;
    background-color: #FFFFFF;
    color: #16191F;
    font-size: 13px;
    min-height: 18px;
}

QSpinBox:focus {
    border: 2px solid #FF9900;
    padding: 6px 9px;
}

QSpinBox:disabled {
    background-color: #F2F3F3;
    color: #687078;
    border: 1px solid #D5DBDB;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border-left: 1px solid #D5DBDB;
    background-color: #FAFAFA;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}

/* Styling the stepper buttons suppresses the native arrows, so draw
   replacements as CSS border triangles. */
QSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #545B64;
}

QSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #545B64;
}

/* --- Scroll Area --- */
QScrollArea#scrollArea {
    background-color: #F5F7FA;
    border: none;
}

QWidget#qt_scrollarea_viewport,
QWidget#scrollAreaContents {
    background-color: #F5F7FA;
}

QScrollBar:vertical {
    background: #F5F7FA;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D5DBDB;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #879596;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Primary Buttons (Save, Add, Search) --- */
QPushButton#button_save,
QPushButton#button_add,
QPushButton#button_search {
    background-color: #FF9900;
    color: #16191F;
    border: none;
    border-radius: 4px;
    padding: 8px 24px;
    font-size: 13px;
    font-weight: bold;
    min-height: 18px;
}

QPushButton#button_save:hover,
QPushButton#button_add:hover,
QPushButton#button_search:hover {
    background-color: #EC7211;
}

QPushButton#button_save:pressed,
QPushButton#button_add:pressed,
QPushButton#button_search:pressed {
    background-color: #D45B07;
}

/* --- Secondary Buttons (Get Location, Update Details, Load More) --- */
QPushButton#button_click,
QPushButton#st_button_click,
QPushButton#ed_button_click,
QPushButton#button_enrich,
QPushButton#button_position_clear,
QPushButton#button_load_more {
    background-color: #FFFFFF;
    color: #16191F;
    border: 1px solid #545B64;
    border-radius: 4px;
    padding: 8px 24px;
    font-size: 13px;
    font-weight: bold;
    min-height: 18px;
}

QPushButton#button_click:hover,
QPushButton#st_button_click:hover,
QPushButton#ed_button_click:hover,
QPushButton#button_enrich:hover,
QPushButton#button_position_clear:hover,
QPushButton#button_load_more:hover {
    background-color: #FAFAFA;
    border: 1px solid #16191F;
}

QPushButton#button_click:pressed,
QPushButton#st_button_click:pressed,
QPushButton#ed_button_click:pressed,
QPushButton#button_enrich:pressed,
QPushButton#button_position_clear:pressed,
QPushButton#button_load_more:pressed {
    background-color: #EAEDED;
}

QPushButton#button_click:disabled,
QPushButton#st_button_click:disabled,
QPushButton#ed_button_click:disabled,
QPushButton#button_enrich:disabled,
QPushButton#button_position_clear:disabled,
QPushButton#button_load_more:disabled {
    background-color: #F2F3F3;
    color: #687078;
    border: 1px solid #D5DBDB;
}

/* --- Cancel Button --- */
QPushButton#button_cancel {
    background-color: #FFFFFF;
    color: #545B64;
    border: 1px solid #D5DBDB;
    border-radius: 4px;
    padding: 8px 24px;
    font-size: 13px;
    min-height: 18px;
}

QPushButton#button_cancel:hover {
    background-color: #FAFAFA;
    border: 1px solid #879596;
    color: #16191F;
}

QPushButton#button_cancel:pressed {
    background-color: #EAEDED;
}

/* --- Keyboard Focus --- */
/* Keep the focus cue when a focused button is also hovered or pressed. */
QPushButton:focus {
    outline: none;
    border: 2px solid #232F3E;
}

QPushButton#button_save:focus,
QPushButton#button_add:focus,
QPushButton#button_search:focus {
    border: 2px solid #16191F;
    padding: 6px 22px;
}

QPushButton#button_click:focus,
QPushButton#st_button_click:focus,
QPushButton#ed_button_click:focus,
QPushButton#button_enrich:focus,
QPushButton#button_position_clear:focus,
QPushButton#button_load_more:focus,
QPushButton#button_cancel:focus {
    border: 2px solid #232F3E;
    padding: 7px 23px;
}

/* --- Check Box --- */
QCheckBox {
    color: #16191F;
    font-size: 13px;
    spacing: 6px;
    margin-top: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D5DBDB;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 1px solid #879596;
}

QCheckBox::indicator:checked {
    background-color: #FF9900;
    border: 1px solid #EC7211;
    image: url(${CHECKMARK_PATH});
}

QCheckBox:disabled {
    color: #687078;
}

QCheckBox::indicator:disabled {
    background-color: #F2F3F3;
    border: 1px solid #D5DBDB;
}

/* --- Message Box --- */
QMessageBox {
    background-color: #F5F7FA;
}

QMessageBox QPushButton {
    background-color: #FF9900;
    color: #16191F;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-weight: bold;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: #EC7211;
}
